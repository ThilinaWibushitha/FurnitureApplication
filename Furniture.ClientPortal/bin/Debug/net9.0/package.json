{
  "name": "tailwind-build",
  "version": "1.0.0",
  "description": "Tailwind CSS build process for Furniture.Admin",
  "scripts": {
    "build-css": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/app.css --watch",
    "build-css-prod": "tailwindcss -i ./wwwroot/app.css -o ./wwwroot/app.css --minify"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38"
  }
}
