@inherits LayoutComponentBase
@inject IAuthenticationService AuthService
@inject NavigationManager NavigationManager

<CascadingAuthenticationState>
    <div class="flex flex-col min-h-screen font-sans text-gray-800 bg-gray-50">
        <!-- Header -->
        <!-- Header -->
        <header class="fixed w-full z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-gray-100">
            <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex justify-between h-20">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 flex items-center cursor-pointer" @onclick='() => NavigationManager.NavigateTo("/")'>
                            <span class="font-playwrite text-3xl font-extrabold text-indigo-600 tracking-tight hover:text-indigo-500 transition-colors">
                                Furniture<span class="text-gray-900">.</span>
                            </span>
                        </div>
                        <div class="hidden sm:ml-10 sm:flex sm:space-x-8">
                            <NavLink href="" Match="NavLinkMatch.All" class="group inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors duration-200 relative">
                                <span>Home</span>
                                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
                            </NavLink>
                            <NavLink href="all-furniture" class="group inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors duration-200 relative">
                                <span>Shop</span>
                                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
                            </NavLink>
                            <NavLink href="trending-furniture" class="group inline-flex items-center px-1 pt-1 text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors duration-200 relative">
                                <span>Trending</span>
                                <span class="absolute bottom-0 left-0 w-full h-0.5 bg-indigo-600 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"></span>
                            </NavLink>
                        </div>
                    </div>
                    <div class="flex items-center space-x-6">
                        <NavLink href="cart" class="text-gray-500 hover:text-indigo-600 relative group transition-colors duration-200">
                            <span class="sr-only">Cart</span>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 transform group-hover:scale-110 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                            </svg>
                        </NavLink>

                        <AuthorizeView>
                            <Authorized>
                                <div class="ml-3 relative group">
                                    <div class="flex items-center space-x-1 cursor-pointer">
                                        <div class="h-8 w-8 rounded-full bg-indigo-100 flex items-center justify-center text-indigo-600 font-bold text-sm">
                                            @(context.User.Identity?.Name?.FirstOrDefault().ToString().ToUpper() ?? "U")
                                        </div>
                                    </div>
                                    <!-- Dropdown menu -->
                                    <div class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform origin-top-right z-50 ring-1 ring-black ring-opacity-5">
                                        <div class="px-4 py-2 border-b border-gray-100">
                                            <p class="text-sm font-medium text-gray-900 truncate">@context.User.Identity?.Name</p>
                                        </div>
                                        <NavLink href="client/dashboard" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-indigo-600">Dashboard</NavLink>
                                        <NavLink href="client/orders" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-indigo-600">Orders</NavLink>
                                        <NavLink href="client/profile" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50 hover:text-indigo-600">Profile</NavLink>
                                        <button @onclick="Logout" class="block w-full text-left px-4 py-2 text-sm text-red-600 hover:bg-red-50">Logout</button>
                                    </div>
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <div class="flex items-center space-x-4">
                                    <NavLink href="login" class="text-sm font-medium text-gray-500 hover:text-indigo-600 transition-colors duration-200">Log in</NavLink>
                                    <NavLink href="create-account" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-full shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200 hover:shadow-md transform hover:-translate-y-0.5">
                                        Sign up
                                    </NavLink>
                                </div>
                            </NotAuthorized>
                        </AuthorizeView>
                    </div>
                </div>
            </nav>
        </header>

         <!-- Spacer for fixed header -->
        <div class="h-20"></div>

        <!-- Main Content -->
        <main class="flex-grow">
            @Body
        </main>

        <!-- Footer -->
        <!-- Footer -->
        <footer class="bg-gray-900 text-white mt-auto py-12 border-t border-gray-800">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-12">
                    <div class="col-span-1 md:col-span-1">
                         <a href="/" class="font-playwrite text-2xl font-bold text-white tracking-wide block mb-4">
                            Furniture<span class="text-indigo-500">.</span>
                        </a>
                        <p class="text-gray-400 text-sm leading-relaxed">
                            Elevating your living spaces with curated, sustainable, and modern furniture designs.
                        </p>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold tracking-wider uppercase text-gray-200 mb-4">Shop</h3>
                        <ul class="space-y-3">
                            <li><a href="all-furniture" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">All Products</a></li>
                            <li><a href="trending-furniture" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">Trending</a></li>
                            <li><a href="#" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">New Arrivals</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold tracking-wider uppercase text-gray-200 mb-4">Support</h3>
                        <ul class="space-y-3">
                            <li><a href="#" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">FAQ</a></li>
                            <li><a href="#" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">Shipping & Returns</a></li>
                            <li><a href="#" class="text-gray-400 hover:text-indigo-400 transition-colors duration-200 text-sm">Contact Us</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-sm font-bold tracking-wider uppercase text-gray-200 mb-4">Stay Connected</h3>
                        <p class="text-gray-400 text-sm mb-4">Subscribe to our newsletter for latest updates.</p>
                         <div class="flex">
                            <input type="email" placeholder="Enter your email" class="w-full px-3 py-2 bg-gray-800 border border-gray-700 rounded-l-md text-sm text-white focus:outline-none focus:ring-1 focus:ring-indigo-500" />
                            <button class="bg-indigo-600 px-4 py-2 rounded-r-md text-sm font-medium hover:bg-indigo-700 transition-colors whitespace-nowrap">Subscribe</button>
                        </div>
                    </div>
                </div>
                <div class="mt-12 border-t border-gray-800 pt-8 flex flex-col md:flex-row justify-between items-center">
                    <p class="text-gray-500 text-sm">&copy; @DateTime.Now.Year Furniture Client. All rights reserved.</p>
                    <div class="flex space-x-6 mt-4 md:mt-0">
                         <a href="#" class="text-gray-500 hover:text-white transition-colors"><span class="sr-only">Facebook</span>FB</a>
                         <a href="#" class="text-gray-500 hover:text-white transition-colors"><span class="sr-only">Twitter</span>TW</a>
                         <a href="#" class="text-gray-500 hover:text-white transition-colors"><span class="sr-only">Instagram</span>IG</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</CascadingAuthenticationState>

@code {
    private async Task Logout()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/");
    }
}
