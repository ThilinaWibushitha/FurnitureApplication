@inherits LayoutComponentBase

<div class="layout-wrapper">
    <header class="header-bar glass-header">
        <div class="header-content">
            <h2 class="title">Furniture Admin</h2>
            <nav class="header-nav">
                <a href="/technical-support" class="nav-link">
                    <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 16.92v3a2 2 0 0 1-2.18 2
                                19.79 19.79 0 0 1-8.63-3.07
                                19.5 19.5 0 0 1-6-6
                                19.79 19.79 0 0 1-3.07-8.67
                                A2 2 0 0 1 4.11 2h3
                                a2 2 0 0 1 2 1.72
                                12.84 12.84 0 0 0 .7 2.81
                                2 2 0 0 1-.45 2.11L8.09 9.91
                                a16 16 0 0 0 6 6l1.27-1.27
                                a2 2 0 0 1 2.11-.45
                                12.84 12.84 0 0 0 2.81.7
                                A2 2 0 0 1 22 16.92z">
                        </path>
                    </svg>
                    Technical Support
                </a>
            </nav>
        </div>
    </header>

    <main class="main-content">
        @Body
    </main>

    <footer class="footer">
        <p>&copy; @DateTime.Now.Year Furniture Store. All rights reserved.</p>
    </footer>
</div>

<style>
    :root {
        /* THEME COLORS (YOUR REQUIREMENTS) */
        --font-main: #603F26;
        --glass-tint: rgba(255, 180, 162, 0.35); /* #FFB4A2 with glass effect */
        --glass-border: rgba(255, 180, 162, 0.45);
        --light-bg: #FFF5F2; /* warm light background */
        --white: #ffffff;
        --shadow-soft: 0 8px 25px rgba(96, 63, 38, 0.15); /* brown shadow */
        --shadow-sm: 0 2px 6px rgba(96, 63, 38, 0.18);
        --nav-hover-bg: rgba(255, 180, 162, 0.25);
        --muted-text: #8c6e5b;
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    html, body {
        height: 100%;
        width: 100%;
        background: var(--light-bg);
        color: var(--font-main);
        font-family: 'Segoe UI', sans-serif;
    }

    .layout-wrapper {
        height: 100vh;
        display: flex;
        flex-direction: column;
        background: var(--light-bg);
        color: var(--font-main);
    }

    /* ---------------- Header (Glass Theme) ---------------- */
    .glass-header {
        backdrop-filter: blur(12px);
        background: var(--glass-tint);
        border-bottom: 1px solid var(--glass-border);
    }

    .header-bar {
        height: 4rem;
        display: flex;
        align-items: center;
        padding: 0 2rem;
        box-shadow: var(--shadow-soft);
    }

    .header-content {
        width: 100%;
        display: flex;
        justify-content: space-between;
        max-width: 1400px;
        margin: 0 auto;
    }

    .title {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--font-main);
    }

    /* ---------------- Navigation ---------------- */
    .header-nav {
        display: flex;
        gap: 1.5rem;
    }

    .nav-link {
        color: var(--font-main);
        text-decoration: none;
        font-weight: 600;
        display: flex;
        align-items: center;
        padding: 0.5rem 1rem;
        border-radius: 10px;
        transition: 0.3s ease;
    }

        .nav-link:hover {
            background: var(--nav-hover-bg);
            box-shadow: var(--shadow-sm);
        }

    .nav-icon {
        margin-right: 6px;
    }

    /* ---------------- Main Content ---------------- */
    .main-content {
        flex: 1;
        padding: 2rem;
        overflow-y: auto;
        animation: fadeIn 0.5s ease;
    }

        .main-content::-webkit-scrollbar {
            width: 8px;
        }

        .main-content::-webkit-scrollbar-thumb {
            background: rgba(96, 63, 38, 0.3);
            border-radius: 4px;
        }

    /* ---------------- Footer ---------------- */
    .footer {
        height: 3rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--white);
        border-top: 1px solid var(--glass-border);
        color: var(--muted-text);
        box-shadow: var(--shadow-sm);
    }

    /* ---------------- Animations ---------------- */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
