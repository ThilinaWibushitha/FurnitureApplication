<div class="top-row ps-3 navbar" style="background-color: #80A1BA;">
    @using Microsoft.AspNetCore.Components.Routing

    <div class="container-fluid d-flex justify-content-center align-items-center">
        <a class="navbar-brand text-white text-center fw-bold" href="" style="font-size: 1.5rem; font-family: 'Playwrite US Trad', cursive;">Furniture Client</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" style="background-color: #E6D8C3;" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" style="color: #1A3636;">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="trending-furniture" style="color: #1A3636;">
                <span class="oi oi-arrow-trending-up" aria-hidden="true"></span> Trending Furniture
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="all-furniture" style="color: #1A3636;">
                <span class="oi oi-grid-four-up" aria-hidden="true"></span> All Furniture
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cart" style="color: #1A3636;">
                <span class="oi oi-cart" aria-hidden="true"></span> Cart
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="login" style="color: #1A3636;">
                <span class="oi oi-account-login" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="create-account" style="color: #1A3636;">
                <span class="oi oi-plus" aria-hidden="true"></span> Create Account
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="forgot-password" style="color: #1A3636;">
                <span class="oi oi-lock-locked" aria-hidden="true"></span> Forgot Password
            </NavLink>
        </div>
    </nav>
</div>

<style>
    .nav-link {
        border-radius: 4px;
        margin: 2px 0;
    }
    
    .nav-link:hover {
        background-color: rgba(255,255,255,0.1);
    }
    
    .nav-link.active {
        background-color: rgba(255,255,255,0.25);
        color: white;
    }
    
    .oi {
        width: 2rem;
        font-size: 1.1rem;
        vertical-align: text-top;
        top: -1px;
    }
</style>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
