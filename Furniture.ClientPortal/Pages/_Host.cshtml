@page "/"
@namespace Furniture.Clientportal.Pages
@using Furniture.Clientportal
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Furniture Admin</title>
    <base href="~/" />
    <link href="https://fonts.googleapis.com/css2?family=Playwrite+US+Trad+Guides&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="Furniture.Clientportal.styles.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <div id="blazor-error-ui" class="alert alert-danger m-3" style="display:none;">
        <p>An unhandled error has occurred.</p>
        <a href="" class="btn btn-sm btn-outline-danger">Reload</a>
        <a class="btn btn-sm btn-close"></a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
