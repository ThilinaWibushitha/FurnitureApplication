@page "/client/dashboard"

<PageTitle>Client Dashboard - Furniture</PageTitle>

<div class="client-dashboard">
    <div class="dashboard-header">
        <h1>Client Dashboard</h1>
        <p class="text-muted">Welcome back! Here's your furniture overview.</p>
    </div>

    <div class="dashboard-stats">
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="stat-card bg-primary text-white">
                    <div class="stat-icon">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div class="stat-content">
                        <h3>@totalItems</h3>
                        <p>Total Items</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card bg-success text-white">
                    <div class="stat-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-content">
                        <h3>@availableItems</h3>
                        <p>Available</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card bg-warning text-white">
                    <div class="stat-icon">
                        <i class="bi bi-clock"></i>
                    </div>
                    <div class="stat-content">
                        <h3>@pendingOrders</h3>
                        <p>Pending Orders</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="stat-card bg-info text-white">
                    <div class="stat-icon">
                        <i class="bi bi-cart"></i>
                    </div>
                    <div class="stat-content">
                        <h3>@completedOrders</h3>
                        <p>Completed Orders</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-content">
        <div class="row">
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5>Recent Orders</h5>
                    </div>
                    <div class="card-body">
                        @if (recentOrders.Any())
                        {
                            <div class="table-responsive">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Order ID</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Total</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var order in recentOrders)
                                        {
                                            <tr>
                                                <td>@order.Id</td>
                                                <td>@order.Date.ToString("MM/dd/yyyy")</td>
                                                <td>
                                                    <span class="badge bg-@(order.Status == "Completed" ? "success" : "warning")">
                                                        @order.Status
                                                    </span>
                                                </td>
                                                <td>@order.Total.ToString("C")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No recent orders found.</p>
                        }
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header">
                        <h5>Quick Actions</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <button class="btn btn-primary">
                                <i class="bi bi-plus-circle me-2"></i>
                                New Order
                            </button>
                            <button class="btn btn-outline-primary">
                                <i class="bi bi-search me-2"></i>
                                Browse Items
                            </button>
                            <button class="btn btn-outline-secondary">
                                <i class="bi bi-clock-history me-2"></i>
                                Order History
                            </button>
                        </div>
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h5>Account Info</h5>
                    </div>
                    <div class="card-body">
                        <p><strong>Client ID:</strong> #CLT001</p>
                        <p><strong>Account Type:</strong> Premium</p>
                        <p><strong>Member Since:</strong> 01/15/2024</p>
                        <button class="btn btn-sm btn-outline-primary">View Profile</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalItems = 0;
    private int availableItems = 0;
    private int pendingOrders = 0;
    private int completedOrders = 0;

    private List<Order> recentOrders = new();

    public class Order
    {
        public string Id { get; set; } = string.Empty;
        public DateTime Date { get; set; }
        public string Status { get; set; } = string.Empty;
        public decimal Total { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        // Simulate loading data
        await Task.Delay(500);

        // Sample data
        totalItems = 156;
        availableItems = 142;
        pendingOrders = 3;
        completedOrders = 28;

        recentOrders = new List<Order>
        {
            new Order { Id = "ORD-001", Date = DateTime.Now.AddDays(-2), Status = "Completed", Total = 1250.00m },
            new Order { Id = "ORD-002", Date = DateTime.Now.AddDays(-5), Status = "Pending", Total = 890.00m },
            new Order { Id = "ORD-003", Date = DateTime.Now.AddDays(-7), Status = "Completed", Total = 2100.00m }
        };
    }
}
