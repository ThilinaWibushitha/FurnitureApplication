@page "/profile"
@using Furniture.ClientPortal.Models
@using Furniture.ClientPortal.Services
@inject IProfileService ProfileService
@inject NavigationManager Navigation

<PageTitle>My Profile | Furniture</PageTitle>

<div class="bg-gray-50 min-h-screen py-10">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Account Settings
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    Manage your personal information and preferences.
                </p>
            </div>
             <div class="mt-4 flex md:mt-0 md:ml-4">
                 <button @onclick='() => Navigation.NavigateTo("client/dashboard")' class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Back to Dashboard
                </button>
            </div>
        </div>

        @if (isLoading)
        {
             <div class="flex flex-col justify-center items-center h-64 space-y-4">
                <div class="animate-spin rounded-full h-10 w-10 border-t-2 border-b-2 border-indigo-600"></div>
                <p class="text-gray-500 font-medium animate-pulse">Loading profile...</p>
            </div>
        }
        else if (profile == null)
        {
            <div class="rounded-md bg-red-50 p-4 border border-red-200">
                <div class="flex">
                    <div class="flex-shrink-0">
                        <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
                        </svg>
                    </div>
                    <div class="ml-3">
                        <h3 class="text-sm font-medium text-red-800">Error loading profile</h3>
                        <div class="mt-2 text-sm text-red-700">
                            <p>Unable to load your profile information. Please try again later.</p>
                        </div>
                         <div class="mt-4">
                            <button type="button" @onclick="LoadProfile" class="inline-flex items-center px-3 py-2 border border-transparent text-sm leading-4 font-medium rounded-md text-red-700 bg-red-100 hover:bg-red-200 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                                Retry
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
             <div class="space-y-6">
                <!-- Personal Info Card -->
                <div class="bg-white shadow rounded-lg border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-200 flex justify-between items-center">
                        <h3 class="text-lg leading-6 font-medium text-gray-900">Personal Information</h3>
                         @if (!isEditing)
                        {
                            <button @onclick="StartEditing" class="text-sm font-medium text-indigo-600 hover:text-indigo-500">
                                Edit
                            </button>
                        }
                    </div>
                    <div class="px-6 py-5">
                         @if (isEditing)
                        {
                            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                                <div class="sm:col-span-3">
                                    <label class="block text-sm font-medium text-gray-700">Phone</label>
                                    <input type="tel" @bind="editRequest.Phone" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                                </div>
                                <div class="sm:col-span-3">
                                    <label class="block text-sm font-medium text-gray-700">Date of Birth</label>
                                    <input type="text" @bind="editRequest.DateOfBirth" placeholder="YYYY-MM-DD" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                                </div>
                                <div class="sm:col-span-6">
                                    <label class="block text-sm font-medium text-gray-700">Address</label>
                                    <input type="text" @bind="editRequest.Address" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                                </div>
                                <div class="sm:col-span-3">
                                    <label class="block text-sm font-medium text-gray-700">City</label>
                                    <input type="text" @bind="editRequest.City" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                                </div>
                                 <div class="sm:col-span-3">
                                    <label class="block text-sm font-medium text-gray-700">Gender</label>
                                    <select @bind="editRequest.Gender" class="mt-1 block w-full py-2 px-3 border border-gray-300 bg-white rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500 sm:text-sm">
                                        <option value="">Select gender</option>
                                        <option value="Male">Male</option>
                                        <option value="Female">Female</option>
                                        <option value="Other">Other</option>
                                        <option value="PreferNotToSay">Prefer not to say</option>
                                    </select>
                                </div>
                                <div class="sm:col-span-6">
                                     <div class="flex items-start">
                                        <div class="flex items-center h-5">
                                            <input id="newsletter" type="checkbox" @bind="newsletterOptIn" class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300 rounded">
                                        </div>
                                        <div class="ml-3 text-sm">
                                            <label for="newsletter" class="font-medium text-gray-700">Newsletter</label>
                                            <p class="text-gray-500">Get the latest news and offers from Furniture App.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-6 flex justify-end space-x-3">
                                <button type="button" @onclick="CancelEditing" class="inline-flex justify-center py-2 px-4 border border-gray-300 shadow-sm text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                                    Cancel
                                </button>
                                <button type="button" @onclick="SaveProfile" disabled="@isSaving" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50">
                                    @(isSaving ? "Saving..." : "Save Changes")
                                </button>
                            </div>
                        }
                        else
                        {
                            <dl class="grid grid-cols-1 gap-x-4 gap-y-6 sm:grid-cols-2">
                                <div class="sm:col-span-1">
                                    <dt class="text-sm font-medium text-gray-500">Full name</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@profile.FirstName @profile.LastName</dd>
                                </div>
                                <div class="sm:col-span-1">
                                    <dt class="text-sm font-medium text-gray-500">Email address</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@(profile.Email ?? "Not set")</dd>
                                </div>
                                <div class="sm:col-span-1">
                                    <dt class="text-sm font-medium text-gray-500">Phone number</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@(profile.Phone ?? "Not set")</dd>
                                </div>
                                <div class="sm:col-span-1">
                                    <dt class="text-sm font-medium text-gray-500">City</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@(profile.City ?? "Not set")</dd>
                                </div>
                                <div class="sm:col-span-2">
                                    <dt class="text-sm font-medium text-gray-500">Address</dt>
                                    <dd class="mt-1 text-sm text-gray-900">@(profile.Address ?? "Not set")</dd>
                                </div>
                                <div class="sm:col-span-1">
                                    <dt class="text-sm font-medium text-gray-500">Loyalty Points</dt>
                                    <dd class="mt-1 text-sm font-bold text-green-600">@profile.LoyaltyPoints pts</dd>
                                </div>
                            </dl>
                        }
                    </div>
                </div>

                <!-- Password Card -->
                <div class="bg-white shadow rounded-lg border border-gray-100 overflow-hidden">
                    <div class="px-6 py-5 border-b border-gray-200">
                        <h3 class="text-lg leading-6 font-medium text-gray-900">Change Password</h3>
                    </div>
                    <div class="px-6 py-5">
                         <div class="grid grid-cols-1 gap-y-6 sm:grid-cols-6">
                            <div class="sm:col-span-4">
                                <label class="block text-sm font-medium text-gray-700">Current Password</label>
                                <input type="password" @bind="currentPassword" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                            </div>
                            <div class="sm:col-span-4">
                                <label class="block text-sm font-medium text-gray-700">New Password</label>
                                <input type="password" @bind="newPassword" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                            </div>
                            <div class="sm:col-span-4">
                                <label class="block text-sm font-medium text-gray-700">Confirm New Password</label>
                                <input type="password" @bind="confirmPassword" class="mt-1 focus:ring-indigo-500 focus:border-indigo-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2" />
                            </div>
                        </div>

                         @if (!string.IsNullOrEmpty(passwordError))
                        {
                            <div class="mt-4 text-sm text-red-600">@passwordError</div>
                        }
                        @if (!string.IsNullOrEmpty(passwordSuccess))
                        {
                            <div class="mt-4 text-sm text-green-600">@passwordSuccess</div>
                        }

                        <div class="mt-6">
                             <button type="button" @onclick="ChangePassword" disabled="@isChangingPassword" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 disabled:opacity-50">
                                @(isChangingPassword ? "Updating..." : "Update Password")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Danger Zone -->
                <div class="bg-white shadow rounded-lg border border-red-200 overflow-hidden">
                    <div class="px-6 py-5 border-b border-red-200 bg-red-50">
                        <h3 class="text-lg leading-6 font-medium text-red-800">Danger Zone</h3>
                    </div>
                    <div class="px-6 py-5">
                        <p class="text-sm text-gray-500 mb-4">
                            Once you delete your account, there is no going back. Please be certain.
                        </p>
                        <button type="button" @onclick="ShowDeleteModal" class="inline-flex justify-center py-2 px-4 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500">
                            Delete Account
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showDeleteModal)
{
     <div class="fixed z-10 inset-0 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" @onclick="HideDeleteModal"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Delete Account</h3>
                             <div class="mt-2">
                                <p class="text-sm text-gray-500 mb-4">
                                    This action cannot be undone. This will permanently delete your account and remove your data from our servers.
                                </p>
                                <div class="space-y-4">
                                     <div>
                                        <label class="block text-sm font-medium text-gray-700">Enter your password to confirm</label>
                                        <input type="password" @bind="deletePassword" class="mt-1 px-3 focus:ring-red-500 focus:border-red-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md py-2 border" />
                                     </div>
                                      <div>
                                        <label class="block text-sm font-medium text-gray-700">Reason for leaving (optional)</label>
                                        <textarea @bind="deleteReason" rows="3" class="mt-1 px-3 focus:ring-red-500 focus:border-red-500 block w-full shadow-sm sm:text-sm border-gray-300 rounded-md border"></textarea>
                                     </div>
                                </div>
                                  @if (!string.IsNullOrEmpty(deleteError))
                                {
                                    <p class="mt-2 text-sm text-red-600">@deleteError</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                    <button type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-50" @onclick="DeleteAccount" disabled="@isDeleting">
                        @(isDeleting ? "Deleting..." : "Delete Permanently")
                    </button>
                    <button type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm" @onclick="HideDeleteModal">
                        Cancel
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* Remove custom CSS as we use Tailwind */
</style>

@code {
    private ClientProfile? profile;
    private UpdateProfileRequest editRequest = new();
    private bool newsletterOptIn;
    
    private bool isLoading = true;
    private bool isEditing = false;
    private bool isSaving = false;
    
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";
    private string passwordError = "";
    private string passwordSuccess = "";
    private bool isChangingPassword = false;
    
    private bool showDeleteModal = false;
    private string deletePassword = "";
    private string deleteReason = "";
    private string deleteError = "";
    private bool isDeleting = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadProfile();
    }

    private async Task LoadProfile()
    {
        isLoading = true;
        profile = await ProfileService.GetProfileAsync();
        if (profile != null)
        {
            editRequest = new UpdateProfileRequest
            {
                Phone = profile.Phone,
                Address = profile.Address,
                City = profile.City,
                DateOfBirth = profile.DateOfBirth,
                Gender = profile.Gender
            };
            newsletterOptIn = profile.NewsletterOptIn;
        }
        isLoading = false;
    }

    private void StartEditing() => isEditing = true;
    private void CancelEditing()
    {
        isEditing = false;
        if (profile != null)
        {
            editRequest = new UpdateProfileRequest
            {
                Phone = profile.Phone,
                Address = profile.Address,
                City = profile.City,
                DateOfBirth = profile.DateOfBirth,
                Gender = profile.Gender
            };
        }
    }

    private async Task SaveProfile()
    {
        isSaving = true;
        try
        {
            editRequest.NewsletterOptIn = newsletterOptIn;
            await ProfileService.UpdateProfileAsync(editRequest);
            await LoadProfile();
            isEditing = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving profile: {ex.Message}");
        }
        isSaving = false;
    }

    private async Task ChangePassword()
    {
        passwordError = "";
        passwordSuccess = "";

        if (string.IsNullOrEmpty(currentPassword) || string.IsNullOrEmpty(newPassword))
        {
            passwordError = "Please fill in all password fields";
            return;
        }

        if (newPassword != confirmPassword)
        {
            passwordError = "New passwords do not match";
            return;
        }

        if (newPassword.Length < 6)
        {
            passwordError = "Password must be at least 6 characters";
            return;
        }

        isChangingPassword = true;
        try
        {
            await ProfileService.ChangePasswordAsync(currentPassword, newPassword);
            passwordSuccess = "Password changed successfully!";
            currentPassword = "";
            newPassword = "";
            confirmPassword = "";
        }
        catch
        {
            passwordError = "Failed to change password. Check your current password.";
        }
        isChangingPassword = false;
    }

    private void ShowDeleteModal() => showDeleteModal = true;
    private void HideDeleteModal()
    {
        showDeleteModal = false;
        deletePassword = "";
        deleteReason = "";
        deleteError = "";
    }

    private async Task DeleteAccount()
    {
        deleteError = "";
        if (string.IsNullOrEmpty(deletePassword))
        {
            deleteError = "Password is required";
            return;
        }

        isDeleting = true;
        try
        {
            await ProfileService.RequestDeleteAccountAsync(deletePassword, deleteReason);
            Navigation.NavigateTo("/logout");
        }
        catch
        {
            deleteError = "Failed to delete account. Check your password.";
        }
        isDeleting = false;
    }
}

