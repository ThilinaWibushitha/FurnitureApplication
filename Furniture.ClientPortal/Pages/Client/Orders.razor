@page "/client/orders"
@using Furniture.ClientPortal.Models
@using Furniture.ClientPortal.Services
@inject IPaymentService PaymentService
@inject NavigationManager Navigation

<PageTitle>My Orders | Furniture</PageTitle>

<div class="bg-gray-50 min-h-screen py-10">
     <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="md:flex md:items-center md:justify-between mb-8">
            <div class="flex-1 min-w-0">
                <h2 class="text-2xl font-bold leading-7 text-gray-900 sm:text-3xl sm:truncate">
                    Orders & Payments
                </h2>
                <p class="mt-1 text-sm text-gray-500">
                    View your order history and manage payments.
                </p>
            </div>
             <div class="mt-4 flex md:mt-0 md:ml-4">
                <button @onclick='() => Navigation.NavigateTo("client/dashboard")' class="inline-flex items-center px-4 py-2 border border-gray-300 rounded-md shadow-sm text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
                    Back to Dashboard
                </button>
            </div>
        </div>

        @if (isLoading)
        {
             <div class="flex flex-col justify-center items-center h-64 space-y-4">
                <div class="animate-spin rounded-full h-10 w-10 border-t-2 border-b-2 border-indigo-600"></div>
                <p class="text-gray-500 font-medium animate-pulse">Loading orders...</p>
            </div>
        }
        else
        {
             <!-- Tabs -->
            <div class="border-b border-gray-200 mb-6">
                <nav class="-mb-px flex space-x-8" aria-label="Tabs">
                    <button @onclick="FilterAll" class="@(statusFilter == null ? "border-indigo-500 text-indigo-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                        All Orders
                    </button>
                    <button @onclick="FilterPending" class="@(statusFilter == "Pending" ? "border-amber-500 text-amber-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                        Pending
                    </button>
                    <button @onclick="FilterCompleted" class="@(statusFilter == "Completed" ? "border-green-500 text-green-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                        Completed
                    </button>
                    <button @onclick="FilterCancelled" class="@(statusFilter == "Cancelled" ? "border-red-500 text-red-600" : "border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300") whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm transition-colors">
                        Cancelled
                    </button>
                </nav>
            </div>

            @if (filteredPayments.Any())
            {
                <div class="space-y-4">
                    @foreach (var payment in filteredPayments)
                    {
                        <div class="bg-white shadow rounded-lg overflow-hidden border border-gray-100 hover:shadow-md transition-shadow">
                            <div class="px-6 py-4 border-b border-gray-50 bg-gray-50/50 flex flex-col sm:flex-row justify-between items-start sm:items-center">
                                <div>
                                    <h3 class="text-sm font-medium text-indigo-600">Order #@payment.OrderId</h3>
                                    <p class="text-xs text-gray-500 mt-1">Placed on @payment.CreatedAt.ToString("MMM dd, yyyy")</p>
                                </div>
                                <div class="mt-2 sm:mt-0">
                                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium @GetStatusBadgeClass(payment.PaymentStatus)">
                                        @payment.PaymentStatus
                                    </span>
                                </div>
                            </div>
                            <div class="px-6 py-4">
                                <div class="flex items-center justify-between">
                                    <div class="space-y-1">
                                         <p class="text-sm text-gray-500">Payment Method: <span class="font-medium text-gray-900">@payment.PaymentMethod</span></p>
                                         @if (!string.IsNullOrEmpty(payment.TransactionRef))
                                        {
                                            <p class="text-xs text-gray-400">Ref: @payment.TransactionRef</p>
                                        }
                                    </div>
                                    <div class="text-right">
                                        <p class="text-lg font-bold text-gray-900">$@payment.Amount.ToString("N2")</p>
                                    </div>
                                </div>
                                
                                @if (payment.PaymentStatus == "Pending")
                                {
                                    <div class="mt-4 border-t border-gray-100 pt-4 flex justify-end">
                                        <button @onclick="() => ShowCancelModal(payment)" class="text-sm text-red-600 hover:text-red-800 font-medium transition-colors">
                                            Cancel Payment
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-12 bg-white rounded-lg shadow-sm border border-gray-100">
                    <svg class="mx-auto h-12 w-12 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    <h3 class="mt-2 text-sm font-medium text-gray-900">No orders found</h3>
                    <p class="mt-1 text-sm text-gray-500">@(statusFilter != null ? $"No {statusFilter.ToLower()} orders available." : "Get started by placing your first order!")</p>
                    @if(statusFilter == null) {
                        <div class="mt-6">
                            <button @onclick='() => Navigation.NavigateTo("all-furniture")' class="inline-flex items-center px-4 py-2 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700">
                                Browse Shop
                            </button>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@if (showCancelModal && selectedPayment != null)
{
    <div class="fixed z-10 inset-0 overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
        <div class="flex items-end justify-center min-h-screen pt-4 px-4 pb-20 text-center sm:block sm:p-0">
            <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true" @onclick="HideCancelModal"></div>
            <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
            <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
                <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                    <div class="sm:flex sm:items-start">
                        <div class="mx-auto flex-shrink-0 flex items-center justify-center h-12 w-12 rounded-full bg-red-100 sm:mx-0 sm:h-10 sm:w-10">
                            <svg class="h-6 w-6 text-red-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                            </svg>
                        </div>
                        <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                            <h3 class="text-lg leading-6 font-medium text-gray-900" id="modal-title">Cancel Payment</h3>
                             <div class="mt-2">
                                <p class="text-sm text-gray-500">
                                    Are you sure you want to cancel this payment of <strong>$@selectedPayment.Amount.ToString("N2")</strong>?
                                </p>
                                 <textarea @bind="cancelReason" rows="3" class="mt-4 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border border-gray-300 rounded-md" placeholder="Reason for cancellation..."></textarea>
                                  @if (!string.IsNullOrEmpty(cancelError))
                                {
                                    <p class="mt-2 text-sm text-red-600">@cancelError</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                    <button type="button" class="w-full inline-flex justify-center rounded-md border border-transparent shadow-sm px-4 py-2 bg-red-600 text-base font-medium text-white hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 sm:ml-3 sm:w-auto sm:text-sm disabled:opacity-50" @onclick="ConfirmCancel" disabled="@isCancelling">
                        @(isCancelling ? "Cancelling..." : "Cancel Payment")
                    </button>
                    <button type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm" @onclick="HideCancelModal">
                        Keep Payment
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Payment> payments = new();
    private List<Payment> filteredPayments = new();
    private string? statusFilter = null;
    private bool isLoading = true;

    private bool showCancelModal = false;
    private Payment? selectedPayment;
    private string cancelReason = "";
    private string cancelError = "";
    private bool isCancelling = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        isLoading = true;
        payments = await PaymentService.GetPaymentsAsync();
        ApplyFilter();
        isLoading = false;
    }

    private void FilterByStatus(string? status)
    {
        statusFilter = status;
        ApplyFilter();
    }

    private void FilterAll() => FilterByStatus(null);
    private void FilterPending() => FilterByStatus("Pending");
    private void FilterCompleted() => FilterByStatus("Completed");
    private void FilterCancelled() => FilterByStatus("Cancelled");

    private void ApplyFilter()
    {
        filteredPayments = statusFilter == null 
            ? payments.ToList() 
            : payments.Where(p => p.PaymentStatus == statusFilter).ToList();
    }

    private string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "Pending" => "bg-yellow-100 text-yellow-800",
            "Completed" => "bg-green-100 text-green-800",
            "Cancelled" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }

    private void ShowCancelModal(Payment payment)
    {
        selectedPayment = payment;
        showCancelModal = true;
    }

    private void HideCancelModal()
    {
        showCancelModal = false;
        selectedPayment = null;
        cancelReason = "";
        cancelError = "";
    }

    private async Task ConfirmCancel()
    {
        if (selectedPayment == null) return;

        cancelError = "";
        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            cancelError = "Please provide a reason for cancellation";
            return;
        }

        isCancelling = true;
        try
        {
            await PaymentService.CancelPaymentAsync(selectedPayment.Id, cancelReason);
            HideCancelModal();
            await LoadPayments();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            cancelError = "Failed to cancel payment. Please try again.";
        }
        isCancelling = false;
    }
}
