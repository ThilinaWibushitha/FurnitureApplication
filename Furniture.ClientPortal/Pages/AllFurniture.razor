@page "/all-furniture"
@using Furniture.ClientPortal.Services
@using Furniture.ClientPortal.Models
@inject IItemService ItemService

<PageTitle>Shop | All Furniture</PageTitle>

<div class="bg-gray-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <h1 class="text-4xl font-playwrite font-bold text-gray-900 tracking-tight sm:text-5xl mb-4">Our Collection</h1>
            <p class="max-w-2xl mx-auto text-xl text-gray-500 font-light">
                Explore our handpicked selection of premium furniture pieces designed to elevate your living space.
            </p>
        </div>

        @if (isLoading)
        {
            <div class="flex flex-col justify-center items-center h-64 space-y-4">
                <div class="animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-indigo-600"></div>
                <p class="text-gray-500 font-medium">Loading collection...</p>
            </div>
        }
        else if (errorMessage != null)
        {
             <div class="text-center py-20 bg-white rounded-3xl shadow-sm border border-red-100">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                    <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Unable to load items</h3>
                <p class="mt-2 text-sm text-gray-500">@errorMessage</p>
                <button @onclick="OnInitializedAsync" class="mt-6 px-4 py-2 bg-indigo-600 text-white rounded-full hover:bg-indigo-700 transition-colors">
                    Try Again
                </button>
            </div>
        }
        else if (items == null || !items.Any())
        {
             <div class="text-center py-24 bg-white rounded-3xl shadow-sm">
                <svg class="mx-auto h-16 w-16 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                </svg>
                <h3 class="mt-4 text-lg font-medium text-gray-900">No products found</h3>
                <p class="mt-2 text-gray-500">Our collection is currently being updated. Please check back soon.</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-y-12 gap-x-8 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                @foreach (var item in items)
                {
                    <div class="group relative flex flex-col bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 ease-in-out transform hover:-translate-y-1">
                        <!-- Image Container -->
                        <div class="relative aspect-w-1 aspect-h-1 overflow-hidden rounded-t-2xl bg-gray-100 h-72">
                             @if (!string.IsNullOrEmpty(item.MainImageUrl))
                            {
                                <img src="@item.MainImageUrl" alt="@item.Name" loading="lazy" class="w-full h-full object-cover object-center transition-transform duration-700 group-hover:scale-110" />
                            }
                            else
                            {
                                <div class="w-full h-full flex items-center justify-center text-gray-300 bg-gray-100">
                                    <svg class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                            }
                            
                            <!-- Badges -->
                             @if (item.DefaultDiscountPercent > 0)
                            {
                                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full shadow-sm">
                                    <span class="text-xs font-bold text-red-500">
                                        SAVE @item.DefaultDiscountPercent%
                                    </span>
                                </div>
                            }

                            <!-- Quick Action Overlay -->
                            <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none group-hover:pointer-events-auto">
                                <a href="product/@item.Id" class="bg-white text-gray-900 px-6 py-2 rounded-full font-medium text-sm hover:bg-indigo-600 hover:text-white transition-colors transform scale-75 group-hover:scale-100 duration-300 shadow-lg">
                                    View Details
                                </a>
                            </div>
                        </div>

                        <!-- Content -->
                        <div class="flex-1 p-6 flex flex-col justify-between">
                            <div>
                                <h3 class="text-lg font-bold text-gray-900 mb-2 truncate group-hover:text-indigo-600 transition-colors">
                                    <a href="product/@item.Id">
                                        <span aria-hidden="true" class="absolute inset-0"></span>
                                        @item.Name
                                    </a>
                                </h3>
                                <p class="text-sm text-gray-500 line-clamp-2 mb-4">@item.Description</p>
                            </div>
                            
                            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-50">
                                <div class="flex flex-col">
                                    <p class="text-sm text-gray-400">Price</p>
                                    <p class="text-xl font-bold text-gray-900">$@item.BasePrice.ToString("N2")</p>
                                </div>
                                <button class="relative z-10 p-3 bg-indigo-50 text-indigo-600 rounded-full hover:bg-indigo-600 hover:text-white transition-all duration-300 shadow-sm hover:shadow-md">
                                     <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" />
                                    </svg>
                                    <span class="sr-only">Add to cart</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private List<Item>? items;
    private bool isLoading = true;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await ItemService.GetItemsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Unable to load furniture items. Please try again later.";
            // Log exception here in a real app
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }
}
