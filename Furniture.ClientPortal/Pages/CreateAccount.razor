@page "/create-account"

@using System.ComponentModel.DataAnnotations
@using Furniture.ClientPortal.Models
@using Furniture.ClientPortal.Services
@inject NavigationManager NavigationManager
@inject IUserService UserService

<PageTitle>Create Account</PageTitle>

<div class="create-account-container">
    <div class="create-account-card">
        <div class="header">
            <h2>Create a New Account</h2>
            <p>Join us to find the best furniture for your home.</p>
        </div>

        <EditForm Model="@model" OnValidSubmit="HandleCreateAccount">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label for="fullName">Full Name</label>
                <InputText id="fullName" class="form-control" @bind-Value="model.FullName" />
                <ValidationMessage For="@(() => model.FullName)" />
            </div>

            <div class="form-group">
                <label for="email">Email</label>
                <InputText id="email" type="email" class="form-control" @bind-Value="model.Email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm Password</label>
                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="model.ConfirmPassword" />
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <button type="submit" class="btn btn-primary" disabled="@isLoading">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                    <span>Creating Account...</span>
                }
                else
                {
                    <span>Create Account</span>
                }
            </button>
        </EditForm>

        <div class="login-link">
            <p>Already have an account? <a href="/login">Log in</a></p>
        </div>
    </div>
</div>

@code {
    private CreateAccountModel model = new CreateAccountModel();
    private bool isLoading = false;
    private string errorMessage = string.Empty;

    private async Task HandleCreateAccount()
    {
        isLoading = true;
        errorMessage = string.Empty;

        if (model.Password != model.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            isLoading = false;
            return;
        }

        try
        {
            var user = new User
            {
                FullName = model.FullName,
                Email = model.Email,
                Password = model.Password
            };

            //var createdUser = await UserService.CreateUserAsync(user);
            //if (createdUser != null)
            //{
            //    NavigationManager.NavigateTo("/login");
            //}
            //else
            //{
            //    errorMessage = "There was an error creating your account. Please try again.";
            //}
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    public class CreateAccountModel
    {
        [Required]
        [StringLength(100, ErrorMessage = "Full name must be at least 2 characters long.", MinimumLength = 2)]
        public string FullName { get; set; }

        [Required]
        [EmailAddress(ErrorMessage = "Invalid email address.")]
        public string Email { get; set; }

        [Required]
        [StringLength(100, ErrorMessage = "Password must be at least 6 characters long.", MinimumLength = 6)]
        public string Password { get; set; }

        [Required]
        [Compare(nameof(Password), ErrorMessage = "Passwords do not match.")]
        public string ConfirmPassword { get; set; }
    }
}
