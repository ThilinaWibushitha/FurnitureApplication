@page "/"

<PageTitle>Home | Modern Furniture</PageTitle>

<!-- Hero Section -->
<!-- Hero Section -->
<section class="relative bg-gray-900 overflow-hidden min-h-[85vh] flex items-center">
    <!-- Background Image -->
    <div class="absolute inset-0">
        <img class="w-full h-full object-cover" src="https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?ixlib=rb-1.2.1&auto=format&fit=crop&w=1932&q=80" alt="Modern Living Room">
        <div class="absolute inset-0 bg-gradient-to-r from-gray-900/90 to-gray-900/20 mix-blend-multiply"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32">
        <div class="lg:w-2/3">
            <h1 class="text-4xl tracking-tight font-extrabold text-white sm:text-5xl md:text-7xl opacity-0 animate-[fadeIn_1s_ease-out_forwards]">
                <span class="block">Design Your</span>
                <span class="block text-indigo-400">Dream Space</span>
            </h1>
            <p class="mt-6 text-xl text-gray-300 max-w-2xl opacity-0 animate-[fadeIn_1s_ease-out_0.5s_forwards]">
                Discover our curated collection of premium furniture. Where comfort meets contemporary art, crafted for your unique lifestyle.
            </p>
            <div class="mt-10 flex flex-col sm:flex-row gap-4 opacity-0 animate-[fadeIn_1s_ease-out_0.8s_forwards]">
                <a href="all-furniture" class="inline-flex items-center justify-center px-10 py-4 border border-transparent text-base font-semibold rounded-full text-gray-900 bg-white hover:bg-gray-100 md:text-lg transition-transform duration-200 hover:scale-105 shadow-xl">
                    Shop Collection
                </a>
                <a href="trending-furniture" class="inline-flex items-center justify-center px-10 py-4 border border-white/30 text-base font-semibold rounded-full text-white hover:bg-white/10 backdrop-blur-sm md:text-lg transition-transform duration-200 hover:scale-105">
                    View Trending
                </a>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<div class="py-24 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center">
            <h2 class="text-base text-indigo-600 font-bold tracking-wide uppercase">Why Choose Us</h2>
            <p class="mt-2 text-3xl leading-8 font-extrabold tracking-tight text-gray-900 sm:text-4xl">
                A better way to furnish your home
            </p>
            <p class="mt-4 max-w-2xl text-xl text-gray-500 mx-auto">
                We believe that furniture should be more than just functional. It should be an expression of your style, crafted to last a lifetime.
            </p>
        </div>

        <div class="mt-20">
            <dl class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="relative bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300">
                    <dt>
                        <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-600 text-white shadow-lg">
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                            </svg>
                        </div>
                        <p class="mt-8 text-lg leading-6 font-bold text-gray-900 text-center">Sustainable Materials</p>
                    </dt>
                    <dd class="mt-4 text-base text-gray-500 text-center">
                        Crafted with eco-friendly materials, ensuring a minimal environmental footprint without compromising quality.
                    </dd>
                </div>

                <div class="relative bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300">
                    <dt>
                        <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-600 text-white shadow-lg">
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                            </svg>
                        </div>
                        <p class="mt-8 text-lg leading-6 font-bold text-gray-900 text-center">Fair Pricing</p>
                    </dt>
                    <dd class="mt-4 text-base text-gray-500 text-center">
                        We work directly with manufacturers to bring you high-quality furniture at honest prices.
                    </dd>
                </div>

                <div class="relative bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300">
                    <dt>
                        <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-600 text-white shadow-lg">
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                            </svg>
                        </div>
                        <p class="mt-8 text-lg leading-6 font-bold text-gray-900 text-center">Fast Delivery</p>
                    </dt>
                    <dd class="mt-4 text-base text-gray-500 text-center">
                        Get your furniture delivered to your doorstep quickly and safely with our reliable partners.
                    </dd>
                </div>

                <div class="relative bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-shadow duration-300">
                    <dt>
                        <div class="absolute -top-6 left-1/2 transform -translate-x-1/2 flex items-center justify-center h-12 w-12 rounded-full bg-indigo-600 text-white shadow-lg">
                            <svg class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                            </svg>
                        </div>
                        <p class="mt-8 text-lg leading-6 font-bold text-gray-900 text-center">24/7 Support</p>
                    </dt>
                    <dd class="mt-4 text-base text-gray-500 text-center">
                        Our customer support team is always available to assist you with any questions or concerns.
                    </dd>
                </div>
            </dl>
        </div>
    </div>
</div>

<!-- Newsletter Section -->
<div class="bg-indigo-700">
    <div class="max-w-7xl mx-auto py-16 px-4 sm:px-6 lg:py-24 lg:px-8 lg:flex lg:items-center lg:justify-between">
        <h2 class="text-3xl font-extrabold tracking-tight text-white sm:text-4xl">
            <span class="block">Ready to dive in?</span>
            <span class="block text-indigo-400">Join our community today.</span>
        </h2>
        <div class="mt-8 flex lg:mt-0 lg:flex-shrink-0 gap-4">
             <a href="create-account" class="inline-flex items-center justify-center px-8 py-3 border border-transparent text-base font-medium rounded-md text-indigo-700 bg-white hover:bg-indigo-50 transition duration-150 ease-in-out shadow-lg">
                Get started
            </a>
             <a href="all-furniture" class="inline-flex items-center justify-center px-8 py-3 border border-indigo-500 text-base font-medium rounded-md text-white hover:bg-indigo-600 transition duration-150 ease-in-out">
                Learn more
            </a>
        </div>
    </div>
</div>
