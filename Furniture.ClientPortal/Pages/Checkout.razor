@page "/checkout"
@using Furniture.ClientPortal.Services
@using Furniture.ClientPortal.Models
@inject ICartService CartService
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject IAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<PageTitle>Checkout</PageTitle>

<div class="checkout-container">
    <h1 class="page-title">Checkout</h1>

    @if (CartService.Items.Count == 0 && string.IsNullOrEmpty(orderSuccessMessage))
    {
        <div class="alert alert-warning">
            Your cart is empty. <a href="/">Go shopping</a>
        </div>
    }
    else if (!string.IsNullOrEmpty(orderSuccessMessage))
    {
         <div class="success-message">
            <div class="icon">✅</div>
            <h2>Order Placed Successfully!</h2>
            <p>Order Number: <strong>@orderSuccessMessage</strong></p>
            <p>Thank you for your purchase.</p>
            <button class="btn btn-primary" @onclick="GoHome">Continue Shopping</button>
        </div>
    }
    else
    {
        <div class="checkout-grid">
            <div class="checkout-form">
                <h3>Billing & Shipping Details</h3>
                 <div class="form-group">
                     <label>Full Name</label>
                     <input type="text" class="form-control" @bind="cardHolderName" />
                 </div>
                 <div class="form-group">
                     <label>Address</label>
                     <input type="text" class="form-control" value="123 Furniture St" />
                 </div>
                 <div class="form-group">
                     <label>City</label>
                     <input type="text" class="form-control" value="Sofa City" />
                 </div>
                 
                 <h3 class="mt-4">Payment Method</h3>
                 <div class="payment-options">
                     <label class="radio-option">
                         <input type="radio" name="payment" checked /> Credit Card
                     </label>
                 </div>
                 
                 <div class="card-details">
                     <div class="form-group box">
                         <label>Card Number</label>
                         <input type="text" class="form-control" placeholder="0000 0000 0000 0000" @bind="cardNumber"/>
                     </div>
                     <div class="row">
                          <div class="col-6">
                              <label>Expiry</label>
                              <input type="text" class="form-control" placeholder="MM/YY" @bind="cardExpiry"/>
                          </div>
                          <div class="col-6">
                              <label>CVC</label>
                              <input type="text" class="form-control" placeholder="123" @bind="cardCvc"/>
                          </div>
                     </div>
                 </div>

            </div>

            <div class="order-summary">
                <h3>Your Order</h3>
                <div class="items-list">
                    @foreach(var item in CartService.Items)
                    {
                        <div class="summary-item">
                            <span>@item.Item.Name x @item.Quantity</span>
                            <span>$@item.SubTotal.ToString("N2")</span>
                        </div>
                    }
                </div>
                <hr />
                <div class="total-row">
                    <span>Total</span>
                    <span>$@CartService.TotalPrice().ToString("N2")</span>
                </div>
                
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger mt-3">@errorMessage</div>
                }

                <button class="btn btn-place-order" @onclick="PlaceOrder" disabled="@isProcessing">
                    @if (isProcessing)
                    {
                        <span>Processing...</span>
                    }
                    else
                    {
                        <span>Place Order</span>
                    }
                </button>
            </div>
        </div>
    }
</div>

@code {
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private string orderSuccessMessage = string.Empty;
    private string cardHolderName = string.Empty;
    private string cardNumber = string.Empty;
    private string cardExpiry = string.Empty;
    private string cardCvc = string.Empty;
    
    private async Task PlaceOrder()
    {
        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            var user = await AuthenticationService.GetCurrentUserAsync();
            if (user == null)
            {
                errorMessage = "You must be logged in to place an order.";
                isProcessing = false;
                return;
            }

            var orderRequest = new CreateOrderRequest
            {
                OrderNumber = "ORD-" + DateTime.Now.Ticks.ToString().Substring(10),
                UserId = user.Id,
                CustomerId = user.Id, 
                TotalAmount = CartService.TotalPrice(),
                Status = "Pending",
                Items = CartService.Items.Select(i => new OrderItem 
                {
                    ItemVariantId = i.Item.Id,
                    Quantity = i.Quantity,
                    UnitPrice = (decimal)i.Item.BasePrice,
                    Subtotal = i.SubTotal
                }).ToList()
            };

            var order = await OrderService.CreateOrderAsync(orderRequest);

            if(order == null) {
                errorMessage = "There was an error creating your order";
                isProcessing = false;
                return;
            }

            var payment = new CreatePaymentRequest 
            {
                OrderId = order.Id,
                Amount = order.TotalAmount,
                PaymentMethod = "Credit Card"
            };

            var paymentResponse = await PaymentService.CreatePaymentAsync(payment);

            if (paymentResponse != null) {
                try {
                    await OrderService.SendOrderConfirmationEmailAsync(order);
                } catch(Exception e) {
                    Console.WriteLine(e.Message);
                }
                orderSuccessMessage = order.OrderNumber;
                CartService.ClearCart();
            } else {
                errorMessage = "There was an error processing your payment. Please try again";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
    
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
