@page "/checkout"
@using Furniture.ClientPortal.Services
@using Furniture.ClientPortal.Models
@inject ICartService CartService
@inject IOrderService OrderService
@inject IPaymentService PaymentService
@inject IAuthenticationService AuthenticationService
@inject NavigationManager NavigationManager

<PageTitle>Secure Checkout | Furniture</PageTitle>

<div class="bg-gray-50 min-h-screen py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-7xl mx-auto">
        <h1 class="text-3xl font-extrabold tracking-tight text-gray-900 mb-8 text-center sm:text-left">Secure Checkout</h1>

        @if (CartService.Items.Count == 0 && string.IsNullOrEmpty(orderSuccessMessage))
        {
            <div class="text-center py-20 bg-white rounded-3xl shadow-sm border border-yellow-100">
                <div class="mx-auto flex items-center justify-center h-16 w-16 rounded-full bg-yellow-50 mb-4">
                    <span class="text-2xl">⚠️</span>
                </div>
                <h3 class="text-lg font-medium text-gray-900">Your cart is empty</h3>
                <p class="mt-2 text-gray-500 mb-6">Please add some items before checking out.</p>
                <a href="all-furniture" class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-full text-indigo-700 bg-indigo-100 hover:bg-indigo-200 transition-colors">
                    Continue Shopping
                </a>
            </div>
        }
        else if (!string.IsNullOrEmpty(orderSuccessMessage))
        {
             <div class="text-center py-24 bg-white rounded-3xl shadow-sm border border-green-100 animate-fade-in-up">
                <div class="mx-auto flex items-center justify-center h-20 w-20 rounded-full bg-green-100 mb-6">
                    <svg class="h-10 w-10 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                </div>
                <h2 class="text-3xl font-extrabold text-gray-900 mb-2">Order Confirmed!</h2>
                <div class="text-sm font-medium text-gray-500 mb-8 space-y-1">
                    <p>Order Number: <span class="text-gray-900 font-mono">@orderSuccessMessage</span></p>
                    <p>Comparison email sent.</p>
                </div>
                <button class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-indigo-600 hover:bg-indigo-700 shadow-lg hover:shadow-xl transition-all" @onclick="GoHome">
                    Continue Shopping
                </button>
            </div>
        }
        else
        {
            <div class="lg:grid lg:grid-cols-12 lg:gap-x-12 lg:items-start">
                <!-- Checkout Form -->
                <div class="lg:col-span-7 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                     @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="mb-8 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg relative" role="alert">
                            <span class="block sm:inline">@errorMessage</span>
                        </div>
                    }

                    <div class="mb-10">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                            <span class="flex items-center justify-center h-6 w-6 rounded-full bg-indigo-100 text-indigo-600 text-xs font-bold mr-2">1</span>
                            Shipping Details
                        </h3>
                        <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                            <div class="sm:col-span-6">
                                <label for="full-name" class="block text-sm font-medium text-gray-700">Full name</label>
                                <div class="mt-1">
                                    <input type="text" id="full-name" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" @bind="cardHolderName" placeholder="John Doe">
                                </div>
                            </div>

                            <div class="sm:col-span-6">
                                <label for="address" class="block text-sm font-medium text-gray-700">Address</label>
                                <div class="mt-1">
                                    <input type="text" id="address" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" value="123 Furniture St">
                                </div>
                            </div>

                            <div class="sm:col-span-3">
                                <label for="city" class="block text-sm font-medium text-gray-700">City</label>
                                <div class="mt-1">
                                    <input type="text" id="city" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" value="Design City">
                                </div>
                            </div>

                            <div class="sm:col-span-3">
                                <label for="postal-code" class="block text-sm font-medium text-gray-700">Postal code</label>
                                <div class="mt-1">
                                    <input type="text" id="postal-code" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" value="10101">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="border-t border-gray-100 pt-10">
                        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                            <span class="flex items-center justify-center h-6 w-6 rounded-full bg-indigo-100 text-indigo-600 text-xs font-bold mr-2">2</span>
                            Payment Method
                        </h3>
                        
                        <div class="flex items-center mb-6">
                            <input id="credit-card" name="payment-type" type="radio" checked class="focus:ring-indigo-500 h-4 w-4 text-indigo-600 border-gray-300">
                            <label for="credit-card" class="ml-3 block text-sm font-medium text-gray-700">
                                Credit Card
                            </label>
                        </div>

                        <div class="bg-gray-50 p-6 rounded-xl border border-gray-200">
                            <div class="grid grid-cols-1 gap-y-6 gap-x-4 sm:grid-cols-6">
                                <div class="sm:col-span-6">
                                    <label for="card-number" class="block text-sm font-medium text-gray-700">Card number</label>
                                    <div class="mt-1">
                                        <input type="text" id="card-number" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" placeholder="0000 0000 0000 0000" @bind="cardNumber">
                                    </div>
                                </div>

                                <div class="sm:col-span-3">
                                    <label for="expiration-date" class="block text-sm font-medium text-gray-700">Expiration date (MM/YY)</label>
                                    <div class="mt-1">
                                        <input type="text" id="expiration-date" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" placeholder="MM/YY" @bind="cardExpiry">
                                    </div>
                                </div>

                                <div class="sm:col-span-3">
                                    <label for="cvc" class="block text-sm font-medium text-gray-700">CVC</label>
                                    <div class="mt-1">
                                        <input type="text" id="cvc" class="shadow-sm focus:ring-indigo-500 focus:border-indigo-500 block w-full sm:text-sm border-gray-300 rounded-md py-3" placeholder="123" @bind="cardCvc">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Summary -->
                 <div class="lg:col-span-5 mt-10 lg:mt-0 bg-gray-50 rounded-2xl p-6 sm:p-8 sticky top-24 border border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900 mb-6">Order Summary</h3>
                    
                    <ul role="list" class="divide-y divide-gray-200 border-b border-gray-200 mb-6">
                        @foreach(var item in CartService.Items)
                        {
                            <li class="flex py-4">
                                <div class="flex-shrink-0">
                                     <img src="@(string.IsNullOrEmpty(item.Item.MainImageUrl) ? "images/placeholder.jpg" : item.Item.MainImageUrl)" alt="@item.Item.Name" class="w-16 h-16 rounded-lg object-center object-cover border border-gray-200" />
                                </div>
                                <div class="ml-4 flex-1 flex flex-col justify-between">
                                    <div>
                                        <h4 class="text-sm font-medium text-gray-900">@item.Item.Name x @item.Quantity</h4>
                                    </div>
                                    <p class="text-sm font-medium text-gray-900 mt-1">$@item.SubTotal.ToString("N2")</p>
                                </div>
                            </li>
                        }
                    </ul>

                    <dl class="space-y-4 mb-8">
                        <div class="flex items-center justify-between">
                            <dt class="text-sm text-gray-600">Subtotal</dt>
                            <dd class="text-sm font-medium text-gray-900">$@CartService.TotalPrice().ToString("N2")</dd>
                        </div>
                        <div class="flex items-center justify-between">
                            <dt class="text-sm text-gray-600">Shipping</dt>
                            <dd class="text-sm font-medium text-gray-900">$0.00</dd>
                        </div>
                        <div class="flex items-center justify-between border-t border-gray-200 pt-4">
                            <dt class="text-base font-bold text-gray-900">Total</dt>
                            <dd class="text-base font-bold text-indigo-600">$@CartService.TotalPrice().ToString("N2")</dd>
                        </div>
                    </dl>

                    <button class="w-full flex justify-center items-center px-6 py-4 border border-transparent rounded-full shadow-sm text-base font-bold text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed" @onclick="PlaceOrder" disabled="@isProcessing">
                        @if (isProcessing)
                        {
                            <svg class="animate-spin -ml-1 mr-3 h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                            </svg>
                            <span>Processing...</span>
                        }
                        else
                        {
                            <span>Place Order</span>
                        }
                    </button>
                    
                    <p class="mt-4 text-center text-xs text-gray-500 flex items-center justify-center">
                        <svg class="h-4 w-4 mr-1 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                        </svg>
                        Secure Encrypted Transaction
                    </p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool isProcessing = false;
    private string errorMessage = string.Empty;
    private string orderSuccessMessage = string.Empty;
    private string cardHolderName = string.Empty;
    private string cardNumber = string.Empty;
    private string cardExpiry = string.Empty;
    private string cardCvc = string.Empty;
    
    private async Task PlaceOrder()
    {
        isProcessing = true;
        errorMessage = string.Empty;

        try
        {
            var user = await AuthenticationService.GetCurrentUserAsync();
            if (user == null)
            {
                errorMessage = "You must be logged in to place an order.";
                isProcessing = false;
                return;
            }

            var orderRequest = new CreateOrderRequest
            {
                OrderNumber = "ORD-" + DateTime.Now.Ticks.ToString().Substring(10),
                UserId = user.Id,
                CustomerId = user.Id, 
                TotalAmount = CartService.TotalPrice(),
                Status = "Pending",
                Items = CartService.Items.Select(i => new OrderItem 
                {
                    ItemVariantId = i.Item.Id,
                    Quantity = i.Quantity,
                    UnitPrice = (decimal)i.Item.BasePrice,
                    Subtotal = i.SubTotal
                }).ToList()
            };

            var order = await OrderService.CreateOrderAsync(orderRequest);

            if(order == null) {
                errorMessage = "There was an error creating your order";
                isProcessing = false;
                return;
            }

            var payment = new CreatePaymentRequest 
            {
                OrderId = order.Id,
                Amount = order.TotalAmount,
                PaymentMethod = "Credit Card"
            };

            var paymentResponse = await PaymentService.CreatePaymentAsync(payment);

            if (paymentResponse != null) {
                try {
                    await OrderService.SendOrderConfirmationEmailAsync(order);
                } catch(Exception e) {
                    Console.WriteLine(e.Message);
                }
                orderSuccessMessage = order.OrderNumber;
                CartService.ClearCart();
            } else {
                errorMessage = "There was an error processing your payment. Please try again";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred: " + ex.Message;
        }
        finally
        {
            isProcessing = false;
        }
    }
    
    private void GoHome()
    {
        NavigationManager.NavigateTo("/");
    }
}
