@page "/login"
@page "/admin/login"
@page "/client/login"
@page "/login/{Type?}"

@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager

<PageTitle>Login - Furniture @(IsAdminLogin ? "Admin" : "Client")</PageTitle>

<style>
    @@keyframes float {
        0%, 100% {
            transform: translateY(0px) scale(1);
        }

        50% {
            transform: translateY(-15px) scale(1.05);
        }
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --accent: #FFB4A2;
        --text-main: #603F26;
        --bg-primary: #EDE7E3;
        --glass-bg: rgba(255, 255, 255, 0.5);
        --glass-border: rgba(255, 255, 255, 0.4);
    }

    body, html {
        width: 100%;
        height: 100%;
        overflow: hidden;
        font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
    }

    .login-wrapper {
        display: flex;
        height: 100vh;
        background: var(--bg-primary);
    }

    /* Left Section - Image Gallery Style */
    .illustration-section {
        flex: 1.2;
        background: linear-gradient(135deg, #ffffff20 0%, #dbe4e820 50%, #9aa1a520 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* Floating Particles */
    .illustration-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at 20% 30%, rgba(255,255,255,0.3), transparent), radial-gradient(circle at 80% 70%, rgba(255,255,255,0.15), transparent);
    }

    .floating-particle {
        position: absolute;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.3);
        animation: float 8s ease-in-out infinite;
    }

    .particle-1 {
        width: 80px;
        height: 80px;
        top: 10%;
        left: 10%;
        animation-delay: 0s;
    }

    .particle-2 {
        width: 60px;
        height: 60px;
        top: 60%;
        left: 15%;
        animation-delay: 2s;
    }

    .particle-3 {
        width: 100px;
        height: 100px;
        bottom: 10%;
        right: 10%;
        animation-delay: 4s;
    }

    /* Image Container */
    .image-container {
        position: relative;
        z-index: 2;
        animation: fadeInUp 1s ease-out;
    }

    .showcase-image {
        width: 80%;
        max-width: 600px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.25);
        transition: transform 0.3s ease;
    }

        .showcase-image:hover {
            transform: scale(1.02);
        }

    /* Brand Badge */
    .brand-badge {
        position: absolute;
        top: -20px;
        left: 50%;
        transform: translateX(-50%);
        background: var(--glass-bg);
        backdrop-filter: blur(10px);
        border: 1px solid var(--glass-border);
        padding: 12px 32px;
        border-radius: 50px;
        color: var(--text-main);
        font-weight: 700;
        font-size: 14px;
        letter-spacing: 1px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    }

    /* Right Section - Form */
    .form-section {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.35);
        backdrop-filter: blur(14px);
        padding: 40px;
        position: relative;
    }

    .glass-card {
        width: 100%;
        max-width: 440px;
        padding: 3rem;
        background: var(--glass-bg);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.1);
        animation: fadeInUp 1s ease-out 0.2s both;
    }

    /* Form Header */
    .form-header {
        margin-bottom: 2rem;
        text-align: center;
    }

    .portal-badge {
        display: inline-block;
        padding: 8px 20px;
        background: linear-gradient(135deg, var(--accent), #E89A8C);
        color: white;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 16px;
        box-shadow: 0 4px 12px rgba(255, 180, 162, 0.3);
    }

    .form-header h1 {
        font-size: 32px;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 8px;
    }

    .form-header p {
        font-size: 15px;
        color: var(--text-main);
        opacity: 0.75;
        line-height: 1.5;
    }

    /* Form Groups */
    .form-group {
        margin-bottom: 24px;
    }

    .input-label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 8px;
    }

    .input-field {
        width: 100%;
        padding: 14px 16px;
        font-size: 15px;
        background: rgba(255, 255, 255, 0.7);
        color: var(--text-main);
        border: 2px solid rgba(0, 0, 0, 0.1);
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .input-field:focus {
            outline: none;
            border-color: var(--accent);
            background: white;
            box-shadow: 0 0 0 4px rgba(255, 180, 162, 0.15);
        }

        .input-field::placeholder {
            color: rgba(96, 63, 38, 0.5);
        }

    .validation-message {
        color: #c53030;
        font-size: 13px;
        margin-top: 6px;
        display: block;
    }

    /* Error Alert */
    .error-alert {
        background: rgba(255, 82, 82, 0.1);
        border: 1px solid rgba(255, 82, 82, 0.3);
        border-radius: 12px;
        padding: 14px 16px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #c53030;
        font-size: 14px;
        animation: fadeInUp 0.3s ease-out;
    }

    /* Actions Row */
    .actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
    }

    .checkbox-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 14px;
        color: var(--text-main);
        cursor: pointer;
    }

        .checkbox-wrap input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: var(--accent);
        }

    .link-text {
        color: var(--accent);
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: opacity 0.2s;
    }

        .link-text:hover {
            opacity: 0.8;
            text-decoration: underline;
        }

    /* Buttons */
    .submit-btn {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, var(--accent), #E89A8C);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s ease;
        box-shadow: 0 8px 20px rgba(255, 180, 162, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

        .submit-btn:hover:not(:disabled) {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(255, 180, 162, 0.45);
        }

        .submit-btn:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

    .spinner {
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top-color: white;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }

    /* Divider */
    .divider {
        display: flex;
        align-items: center;
        text-align: center;
        margin: 28px 0;
        color: var(--text-main);
        opacity: 0.6;
        font-size: 13px;
        font-weight: 500;
    }

        .divider::before,
        .divider::after {
            content: '';
            flex: 1;
            border-bottom: 1px solid rgba(0, 0, 0, 0.15);
        }

        .divider span {
            padding: 0 16px;
        }

    /* Secondary Button */
    .switch-btn {
        width: 100%;
        padding: 14px;
        background: transparent;
        border: 2px solid rgba(0, 0, 0, 0.15);
        color: var(--text-main);
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .switch-btn:hover {
            background: rgba(255, 255, 255, 0.5);
            border-color: var(--accent);
        }

    /* Footer */
    .footer-text {
        text-align: center;
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid rgba(0, 0, 0, 0.1);
        font-size: 14px;
        color: var(--text-main);
        opacity: 0.8;
    }

    /* Responsive */
    @@media (max-width: 968px) {
        .login-wrapper {
            flex-direction: column;
        }

        .illustration-section {
            flex: 0;
            min-height: 250px;
            padding: 20px;
        }

        .showcase-image {
            max-width: 400px;
        }

        .brand-badge {
            font-size: 12px;
            padding: 8px 20px;
        }

        .form-section {
            flex: 1;
            padding: 20px;
        }

        .glass-card {
            padding: 2rem;
            max-width: 100%;
        }

        .form-header h1 {
            font-size: 26px;
        }

        .floating-particle {
            display: none;
        }
    }

    @@media (max-width: 480px) {
        .glass-card {
            padding: 1.5rem;
        }

        .illustration-section {
            min-height: 200px;
        }

        .showcase-image {
            max-width: 300px;
        }
    }

    /* Admin Portal Button */
    .admin-portal-btn {
        width: 100%;
        padding: 14px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 16px;
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.35);
    }

        .admin-portal-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(102, 126, 234, 0.45);
        }
</style>

<div class="login-wrapper">
    <!-- Left: Illustration / Image -->
    <div class="illustration-section">
        <div class="illustration-bg"></div>

        <!-- Floating Particles -->
        <div class="floating-particle particle-1"></div>
        <div class="floating-particle particle-2"></div>
        <div class="floating-particle particle-3"></div>

        <!-- Image with Badge -->
        <div class="image-container">
            <div class="brand-badge">FURNITURE STORE</div>
            <img src="images/dining-table.jpg" class="showcase-image" alt="Modern Dining Table" />
        </div>
    </div>

    <!-- Right: Login Form -->
    <div class="form-section">
        <div class="glass-card">
            <div class="form-header">
                <span class="portal-badge">
                    @(IsAdminLogin ? "🔐 Admin Access" : "👤 Client Portal")
                </span>
                <h1>Welcome Back</h1>
                <p>@(IsAdminLogin ? "Secure access for inventory management" : "Manage your orders and preferences")</p>
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="@HandleLoginAsync">
                <DataAnnotationsValidator />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="error-alert" role="alert">
                        <span>⚠️</span>
                        <span>@errorMessage</span>
                    </div>
                }

                <div class="form-group">
                    <label class="input-label">Email Address</label>
                    <InputText @bind-Value="loginModel.Email"
                               class="input-field"
                               placeholder="name@example.com"
                               autocomplete="email" />
                    <ValidationMessage For="@(() => loginModel.Email)" class="validation-message" />
                </div>

                <div class="form-group">
                    <label class="input-label">Password</label>
                    <InputText type="password"
                               @bind-Value="loginModel.Password"
                               class="input-field"
                               placeholder="Enter your password"
                               autocomplete="current-password" />
                    <ValidationMessage For="@(() => loginModel.Password)" class="validation-message" />
                </div>

                <div class="actions">
                    <label class="checkbox-wrap">
                        <InputCheckbox @bind-Value="loginModel.RememberMe" />
                        <span>Remember me</span>
                    </label>
                    <a href="/forgot-password" class="link-text">Forgot password?</a>
                </div>

                <button type="submit" class="submit-btn" disabled="@isLoading">
                    @if (isLoading)
                    {
                        <span class="spinner"></span>
                        <span>Authenticating...</span>
                    }
                    else
                    {
                        <span>Sign In</span>
                        <span>→</span>
                    }
                </button>
            </EditForm>

            <div class="divider">
                <span>OR</span>
            </div>

            <button type="button" class="switch-btn" @onclick="NavigateToCreateAccount">
                Create New Account
            </button>

            <button type="button" class="admin-portal-btn" @onclick="NavigateToAdminPortal">
                🔐 Switch to Admin Portal
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string? Type { get; set; }

    private LoginModel loginModel = new LoginModel();
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    private bool IsAdminLogin =>
        string.Equals(Type, "admin", StringComparison.OrdinalIgnoreCase) ||
        NavigationManager.Uri.Contains("/admin/login", StringComparison.OrdinalIgnoreCase);

    public class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email address")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; }
    }

    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Type))
        {
            if (NavigationManager.Uri.Contains("/admin/login"))
                Type = "admin";
            else
                Type = "client";
        }
    }

    private async Task HandleLoginAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            await Task.Delay(1500); // Simulate network delay

            // Mock Logic - Replace with actual authentication service
            if (loginModel.Email.Contains("error"))
            {
                errorMessage = "Invalid credentials. Please check your email and password.";
                return;
            }

            if (IsAdminLogin)
                NavigationManager.NavigateTo("/", forceLoad: true);
            else
                NavigationManager.NavigateTo("/client/dashboard", forceLoad: true);
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToCreateAccount()
    {
        NavigationManager.NavigateTo("/create-account");
    }

    private void NavigateToAdminPortal()
    {
        NavigationManager.NavigateTo("http://localhost:5100/login", forceLoad: true);
    }
}